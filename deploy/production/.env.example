# This stack is independent of /srv/zero-one and must never mount its state.
VERIFIER_REVISION=<full-zero-one-api-verifier-git-commit>
VERIFIER_DATA_DIR=/srv/zero-one-verifier/state
VERIFIER_LOCAL_PORT=8180

# Only needed with compose.tunnel.yaml. Keep the token outside Git.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.1@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4
VERIFIER_TUNNEL_TOKEN_FILE=/srv/zero-one-verifier/secrets/tunnel-token
